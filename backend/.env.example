# ═══════════════════════════════════════════════════════════════
# UniPass Backend — Environment Variables Template
# Copy this file to .env and fill in all values
# ⚠️  NEVER commit .env to Git
# ═══════════════════════════════════════════════════════════════

# ─── Supabase Project ────────────────────────────────────────────
# Your Supabase project URL (Dashboard → Settings → API → Project URL)
SUPABASE_URL="https://your-project-ref.supabase.co"

# Anon/public key (safe to use in browser — limited RLS access)
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Service role key (server-side only — bypasses RLS — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ─── Database Connection (Prisma → Supabase PostgreSQL) ──────────
# Transaction Pooler — runtime app queries (port 6543)
# Dashboard → Project Settings → Database → Connection String → Transaction mode
DATABASE_URL="postgresql://postgres.your-project-ref:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Session / Direct — Prisma migrations only (port 5432)
# Dashboard → Project Settings → Database → Connection String → Session mode
DIRECT_URL="postgresql://postgres.your-project-ref:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── JWT Secrets ─────────────────────────────────────────────────
# Must be at least 32 characters. Use a random generator.
# https://generate-secret.vercel.app/64
JWT_SECRET="your-super-secret-jwt-key-minimum-32-chars"

# Must be DIFFERENT from JWT_SECRET
QR_SECRET="your-different-super-secret-qr-key-minimum-32-chars"

JWT_EXPIRES_IN="7d"

# ─── Server ──────────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"

# ─── Business Rules ──────────────────────────────────────────────
ADMISSION_GRACE_MINUTES=30

# ─── Timezone ────────────────────────────────────────────────────
TZ="Asia/Kolkata"

# ─── CORS ────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:5173"
